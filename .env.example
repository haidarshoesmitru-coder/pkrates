# Public site URL — used for absolute URLs in sitemap.xml,
# robots.txt and canonical/OG metadata (see lib/site-url.ts).
# Leave unset to fall back to https://pkrates-app.vercel.app;
# set this to the custom domain once one is live.
NEXT_PUBLIC_SITE_URL=

# Supabase — public site + admin reads (anon key, respects RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-only, NEVER exposed to the client bundle.
# Used exclusively by lib/supabase/admin.ts for admin write actions
# (submit/approve/reject) until real per-user Supabase Auth exists —
# see the comment at the top of that file for why, and what changes
# once auth ships.
SUPABASE_SERVICE_ROLE_KEY=
